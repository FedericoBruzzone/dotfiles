#!/usr/bin/env bash
set -euo pipefail

# --- Configuration ---
# Single build, single config: -DLLVM_ENABLE_PROJECTS="mlir;clang" already
# produces every tool needed for both MLIR and plain LLVM/Clang workflows
# (mlir-opt, mlir-translate, opt, llc, clang, FileCheck, llvm-lit, ...).
REPO_ROOT=${REPO_ROOT:-~/dev/llvm-project}
BUILD_DIR=${BUILD_DIR:-${REPO_ROOT}/build}
BIN=${BUILD_DIR}/bin
# Leave unset for native SME/I8MM detection (via sysctl on Darwin) with
# clean pass/skip/xfail results. Set to "env" only for features without a
# Darwin hwcap mapping yet, where CMake would otherwise hard-error asking
# for an emulator -- note this also makes the arm-emulator lit feature
# available, so SME's/I8MM's VL-forcing or emulator-only tests will be
# attempted (and fail) again instead of being cleanly skipped.
# Usefull for enable it:
# `cmake -S llvm -B build -DARM_EMULATOR_EXECUTABLE=env`
# `cmake -S llvm -B build -DARM_EMULATOR_EXECUTABLE=`
ARM_EMULATOR_EXECUTABLE=${ARM_EMULATOR_EXECUTABLE:-}
# Set to non-empty (e.g. ASAN=ON) to enable AddressSanitizer. Defaults to
# Release build type; for readable stack traces use Debug or RelWithDebInfo:
#   ASAN=ON llvm-mlir-helper build config --type {Debug|RelWithDebInfo}
ASAN=${ASAN:-}

# Default lowering to the LLVM dialect, the same as the matmul-study pipelines.
MLIR_TO_LLVM=(
    --lower-vector-mask --expand-strided-metadata --lower-affine
    "--convert-vector-to-scf=target-rank=1 full-unroll=true" --lower-affine
    "--convert-vector-to-llvm=vector-contract-lowering=outerproduct"
    --convert-scf-to-cf --convert-cf-to-llvm --convert-arith-to-llvm
    --convert-math-to-llvm "--convert-func-to-llvm=use-bare-ptr-memref-call-conv=1"
    --finalize-memref-to-llvm --convert-index-to-llvm --convert-ub-to-llvm
    --reconcile-unrealized-casts
)
# Without a schedule, linalg/tensor ops are only bufferized and turned into scalar loops.
MLIR_LINALG_TO_LOOPS=(
    "--one-shot-bufferize=bufferize-function-boundaries function-boundary-type-conversion=identity-layout-map"
    --convert-linalg-to-loops
)

# --- Usage ---
usage_build() {
    cat <<EOF
build                                     Configure and build the project (mlir+clang).
  build [TARGET...]                       Build with ninja (default target: all). Extra ninja flags pass through.
  build config [--type T]                 Configure with CMake (default type: Release).
  build rebuild [--type T]                Wipe the build directory, configure and build.
  build clean                             Remove the build directory.
EOF
}

usage_test() {
    cat <<EOF
test                                      Run and update tests.
  test lit <path...>                      Run lit on a folder or file.
  test update <file>                      Regenerate the CHECK lines of a .mlir or .ll test.
                                          .mlir: runs the first RUN line up to '| FileCheck' and feeds
                                          its output to mlir/utils/generate-test-checks.py.
  test check <suite...>                   Run ninja check-<suite>, e.g. mlir, llvm, llvm-unit, clang, clang-unit.
EOF
}

usage_mlir() {
    cat <<EOF
mlir                                      Work on .mlir files.
  mlir debug <file> [--pipeline P] [--only TYPE] [--emit E]
                                          mlir-opt with --debug (or --debug-only=TYPE), debug info and timing.
                                          --emit: stdout (default), file (<file>.opt.mlir), none.
  mlir pass <file> <pass> [--only TYPE] [--emit E]
                                          Run one pass with --debug-only=<pass> (or TYPE) and timing.
                                          --emit: none (default), stdout, file (<file>.<pass>.mlir).
  mlir print-ir <file> [--pipeline P]     Print the IR before and after every pass (default: canonicalize,cse).
  mlir lower <file> [--schedule F] [--pipeline P] [--emit E]
                                          Lower to the LLVM dialect. --schedule applies a transform-dialect
                                          schedule first (a transform.named_sequence in the file is applied
                                          automatically). --pipeline replaces the default lowering, and then
                                          also the linalg/tensor to scalar loops fallback.
                                          --emit: stdout (default), file (<file>.llvm.mlir), none.
  mlir translate <file> [--to ll|bc] [--emit E]
                                          mlir-translate an LLVM-dialect module to LLVM IR or bitcode.
                                          --emit: file (default, <file>.ll or <file>.bc), stdout.
  mlir compile <file> [-o OUT] [-O L] [LOWERING]
                                          Lower, translate, llc (default -O0) and link an executable (default: <file>).
  mlir asm <file> [--cpu C] [-O L] [--llc-flags F] [--emit E] [LOWERING]
                                          Assembly via llc (default -mcpu=native -O3).
                                          --emit: stdout (default, header on stderr), file (<file>.s), none.
  LOWERING (compile, asm): [--schedule F] [--pipeline P] [--lower|--no-lower]
                                          Same as 'mlir lower'. By default the file is lowered when it holds
                                          func/arith/scf/vector/memref/... ops and is left alone when it is
                                          already in the LLVM dialect. --lower forces it, --no-lower skips it.
EOF
}

usage_llvm() {
    cat <<EOF
llvm                                      Work on .ll and .bc files.
  llvm debug <file> [-O L] [--only TYPE] [--emit E]
                                          opt (default -O0) with -debug (or -debug-only=TYPE) and -stats.
                                          --emit: stdout (default), file (<file>.opt.ll), bc (<file>.opt.bc), none.
  llvm pass <file> <pass> [--only TYPE] [--emit E]
                                          Run one pass with -debug-only=<pass> (or TYPE) and -stats.
                                          --emit: none (default), stdout, file (<file>.<pass>.ll), bc (<file>.<pass>.bc).
  llvm pipeline [-O L]                    Print the opt pass pipeline (default -O0).
  llvm compile <file> [-o OUT] [-O L]     llc (default -O0) and link an executable (default: <file>).
  llvm link <file> [-o OUT] [-O L]        Compile and link directly with clang, no llc step (default -O0).
  llvm asm <file> [--cpu C] [-O L] [--llc-flags F] [--emit E]
                                          Assembly via llc (default -mcpu=native -O3).
                                          --emit: stdout (default, header on stderr), file (<file>.s), none.
EOF
}

usage_c() {
    cat <<EOF
c                                         Work on .c files with the built clang.
  c emit-llvm <file.c> [-O L] [--emit E]  Generate LLVM IR (default -O0).
                                          --emit: file (default, <file>.ll), stdout.
  c pass <file.c> <pass> [-O L] [--only TYPE]
                                          Compile to LLVM IR on stdout with -debug-only=<pass> (or TYPE).
EOF
}

usage() {
    local me
    me=$(basename "$0")
    cat <<EOF
Usage: ${me} <group> <command> [arguments] [options]
       ${me} <group> help

EOF
    usage_build; echo
    usage_test; echo
    usage_mlir; echo
    usage_llvm; echo
    usage_c
    cat <<EOF

Common options:
  -O L          Optimization level: -O0, -O1, -O2, -O3, -Os, -Oz.
  --pipeline P  MLIR pass pipeline, e.g. 'canonicalize,cse' (a full 'builtin.module(...)' works too).
  --cpu C       llc -mcpu, e.g. apple-m4, neoverse-n1.
  --llc-flags F Extra llc flags, e.g. '-mattr=+sve'.

Environment:
  REPO_ROOT               Path to the llvm-project repo root (default: ~/dev/llvm-project)
  BUILD_DIR               Path to the build directory (default: \$REPO_ROOT/build)
  ARM_EMULATOR_EXECUTABLE Emulator for AArch64 integration tests (default: unset).
                          Unset: native SME/I8MM detection, clean pass/skip/xfail results.
                          Set to 'env' only for emulator-only tests (e.g. SVE, VL-forcing SME).
  ASAN                    Enable AddressSanitizer (default: unset, builds in Release).
                          For readable stack traces: ASAN=ON ${me} build config --type {Debug|RelWithDebInfo}
EOF
}

# --- Helpers ---
die() { echo "Error: $*" >&2; exit 1; }
# Status lines go to stderr, so stdout only carries the tool output and can be piped.
log() { echo "--- $* ---" >&2; }
note() { echo "($*)" >&2; }

sysroot() {
    if [[ "$OSTYPE" == darwin* ]]; then echo "-isysroot $(xcrun --show-sdk-path)"; fi
}

F_O= F_o= F_cpu= F_emit= F_llc_flags= F_lower= F_no_lower= F_only= F_pipeline= F_schedule= F_to= F_type=
# Splits "$@" into POS (positional arguments) and F_<flag> variables.
# $1 lists the accepted flags: "name" takes a value, "name!" is a switch, "O" is -O<level>.
parse_args() {
    local spec=" $1 " arg name
    shift
    POS=()
    while [ $# -gt 0 ]; do
        arg=$1; shift
        case $arg in
            -O?) [[ $spec == *" O "* ]] || die "unexpected option '$arg'"; F_O=$arg; continue ;;
            -o)  name=o ;;
            --*) name=${arg#--} ;;
            -*)  die "unknown option '$arg'" ;;
            *)   POS+=("$arg"); continue ;;
        esac
        if [[ $spec == *" $name! "* ]]; then
            printf -v "F_${name//-/_}" 1
        elif [[ $spec == *" $name "* ]]; then
            [ $# -gt 0 ] || die "option '$arg' needs a value"
            printf -v "F_${name//-/_}" '%s' "$1"; shift
        else
            die "unknown option '$arg'"
        fi
    done
}

# need <min> <max> <usage>: checks the number of positional arguments.
need() {
    if [ ${#POS[@]} -lt "$1" ] || [ ${#POS[@]} -gt "$2" ]; then
        die "usage: $(basename "$0") $3"
    fi
}

# Sets OUT to the -o flags for --emit: stdout, file (written to $2) or none.
set_out() {
    case $1 in
        stdout) OUT=(-o -) ;;
        file)   OUT=(-o "$2") ;;
        none)   OUT=(-o /dev/null) ;;
        *) die "unknown --emit '$1' (expected stdout, file or none)" ;;
    esac
}

# Like set_out, plus bc. $2 is the output path without extension.
set_llvm_out() {
    case $1 in
        bc) OUT=(-o "$2.bc") ;;
        *)  set_out "$1" "$2.ll"; OUT=(-S "${OUT[@]}") ;;
    esac
}

wrap_pipeline() {
    case $1 in
        builtin.module\(*) echo "$1" ;;
        *) echo "builtin.module($1)" ;;
    esac
}

link_exe() {
    # shellcheck disable=SC2046
    "${BIN}/clang" "$@" $(sysroot)
}

# --- build ---
build_config() {
    parse_args "type" "$@"
    need 0 0 "build config [--type T]"
    local type=${F_type:-Release}
    log "Configuring project (mlir+clang, BUILD_TYPE=${type}${ASAN:+, ASAN=ON})"
    cmake -G Ninja \
        -S "${REPO_ROOT}/llvm" \
        -B "${BUILD_DIR}" \
        -DCMAKE_BUILD_TYPE="${type}" \
        -DLLVM_ENABLE_PROJECTS="mlir;clang" \
        -DLLVM_TARGETS_TO_BUILD="AArch64;host" \
        -DMLIR_INCLUDE_INTEGRATION_TESTS=ON \
        -DMLIR_RUN_ARM_SME_TESTS=ON \
        -DMLIR_RUN_ARM_NEON_TESTS=ON \
        -DARM_EMULATOR_EXECUTABLE="${ARM_EMULATOR_EXECUTABLE}" \
        -DLLVM_ENABLE_RUNTIMES="" \
        -DLLVM_ENABLE_EH=ON \
        -DLLVM_ENABLE_RTTI=ON \
        -DLLVM_ENABLE_ASSERTIONS=ON \
        -DCMAKE_C_COMPILER=/usr/bin/clang \
        -DCMAKE_CXX_COMPILER=/usr/bin/clang++ \
        -DCMAKE_OSX_SYSROOT="$(xcrun --show-sdk-path)" \
        -DLLVM_CCACHE_BUILD=ON \
        ${ASAN:+-DLLVM_USE_SANITIZER=Address}
}

build_targets() {
    log "Building target: ${*:-all}"
    ninja -C "${BUILD_DIR}" "$@"
}

build_clean() {
    log "Cleaning build directory"
    rm -rf "${BUILD_DIR}"
}

group_build() {
    case ${1:-} in
        config)  shift; build_config "$@" ;;
        rebuild) shift; log "Rebuilding project from scratch"; build_clean; build_config "$@"; build_targets ;;
        clean)   shift; parse_args "" "$@"; need 0 0 "build clean"; build_clean ;;
        help)    usage_build; exit 0 ;;
        *)       build_targets "$@" ;;
    esac
}

# --- test ---
test_lit() {
    parse_args "" "$@"
    need 1 1000 "test lit <path...>"
    log "Running lit tests"
    "${BIN}/llvm-lit" -a -v "${POS[@]}"
}

# The first RUN line (with its continuations) up to '| FileCheck', with %s replaced by the file.
mlir_run_command() {
    local cmd
    cmd=$(awk '/\/\/ *RUN:/ {
        s = $0; sub(/.*RUN:[ \t]*/, "", s)
        cont = sub(/\\[ \t]*$/, "", s)
        cmd = cmd s
        if (!cont) { print cmd; exit }
    }' "$1" | sed -E 's/\|[[:space:]]*FileCheck.*//')
    [ -n "$cmd" ] || die "no RUN line in '$1'"
    echo "${cmd//%s/$(printf %q "$1")}"
}

test_update() {
    parse_args "" "$@"
    need 1 1 "test update <file.mlir|file.ll>"
    local input=${POS[0]}
    log "Updating FileCheck patterns in ${input}"
    case $input in
        *.mlir)
            local cmd out
            cmd=$(mlir_run_command "$input")
            note "$cmd"
            # Run first and only then rewrite the file, so a failing RUN line does not wipe its CHECKs.
            out=$(PATH="${BIN}:${PATH}" eval "$cmd")
            python3 "${REPO_ROOT}/mlir/utils/generate-test-checks.py" --source "$input" -i <<<"$out"
            ;;
        *.ll)
            python3 "${REPO_ROOT}/llvm/utils/update_test_checks.py" \
                --opt-binary="${BIN}/opt" --version 5 "$input"
            ;;
        *) die "cannot update '${input}' (expected .mlir or .ll)" ;;
    esac
}

test_check() {
    parse_args "" "$@"
    need 1 100 "test check <suite...>"
    local suite targets=()
    for suite in "${POS[@]}"; do targets+=("check-${suite#check-}"); done
    log "Running ${targets[*]}"
    ninja -C "${BUILD_DIR}" "${targets[@]}"
}

group_test() {
    local cmd=${1:-help}
    [ $# -gt 0 ] && shift
    case $cmd in
        lit)    test_lit "$@" ;;
        update) test_update "$@" ;;
        check)  test_check "$@" ;;
        help)   usage_test; exit 0 ;;
        *)      usage_test >&2; die "unknown test command '${cmd}'" ;;
    esac
}

# --- mlir ---
mlir_debug() {
    parse_args "pipeline only emit" "$@"
    need 1 1 "mlir debug <file> [--pipeline P] [--only TYPE] [--emit E]"
    local input=${POS[0]} emit=${F_emit:-stdout} flags=()
    set_out "$emit" "${input%.*}.opt.mlir"
    [ -n "$F_pipeline" ] && flags+=("--pass-pipeline=$(wrap_pipeline "$F_pipeline")")
    if [ -n "$F_only" ]; then flags+=("--debug-only=${F_only}"); else flags+=(--debug); fi
    log "Running mlir-opt on ${input} (emit: ${emit})"
    "${BIN}/mlir-opt" "${flags[@]}" --mlir-print-debuginfo --mlir-timing "${OUT[@]}" "$input"
}

mlir_pass() {
    parse_args "only emit" "$@"
    need 2 2 "mlir pass <file> <pass> [--only TYPE] [--emit E]"
    local input=${POS[0]} pass=${POS[1]} emit=${F_emit:-none}
    local name=${pass%%\{*}
    set_out "$emit" "${input%.*}.${name}.mlir"
    log "Running pass ${pass} on ${input} (emit: ${emit})"
    "${BIN}/mlir-opt" \
        --pass-pipeline="builtin.module(${pass})" \
        --debug-only="${F_only:-$name}" \
        --mlir-timing \
        "${OUT[@]}" "$input"
}

mlir_print_ir() {
    parse_args "pipeline" "$@"
    need 1 1 "mlir print-ir <file> [--pipeline P]"
    local pipeline=${F_pipeline:-canonicalize,cse}
    log "Printing MLIR pipeline for passes: ${pipeline}"
    "${BIN}/mlir-opt" \
        --pass-pipeline="$(wrap_pipeline "$pipeline")" \
        --mlir-timing \
        --mlir-print-ir-before-all \
        --mlir-print-ir-after-all \
        "${POS[0]}" -o /dev/null
}

# mlir_lower_file <file> [mlir-opt output flags...]: the schedule (F_schedule, or the one in the file),
# then F_pipeline or the default lowering to the LLVM dialect. Writes to stdout unless told otherwise.
mlir_lower_file() {
    local input=$1 stage0=("${BIN}/mlir-opt" "$1") stage1=("${BIN}/mlir-opt" -)
    shift
    if [ -n "$F_schedule" ]; then
        note "applying the schedule ${F_schedule}"
        stage0+=("--transform-preload-library=transform-library-paths=${F_schedule}" --transform-interpreter)
    elif grep -q 'transform\.named_sequence' "$input"; then
        note "the file has its own schedule: applying it"
        stage0+=(--transform-interpreter --test-transform-dialect-erase-schedule)
    elif [ -z "$F_pipeline" ] && grep -qE '\b(linalg|tensor)\.[a-z_]+' "$input"; then
        note "linalg/tensor ops: bufferizing and lowering to scalar loops, no vectorization; use --schedule <file> for a vectorized kernel"
        stage0+=("${MLIR_LINALG_TO_LOOPS[@]}")
    fi
    if [ -n "$F_pipeline" ]; then
        note "lowering with the pipeline ${F_pipeline}"
        stage1+=("--pass-pipeline=$(wrap_pipeline "$F_pipeline")")
    else
        note "lowering to the LLVM dialect"
        stage1+=("${MLIR_TO_LLVM[@]}")
    fi
    "${stage0[@]}" | "${stage1[@]}" "$@"
}

check_lowering_flags() {
    if [ -n "$F_no_lower" ] && [ -n "$F_lower$F_schedule$F_pipeline" ]; then
        die "--no-lower excludes --lower, --schedule and --pipeline"
    fi
}

# Whether the file has to be lowered before mlir-translate (see LOWERING in the usage).
mlir_needs_lower() {
    [ -n "$F_no_lower" ] && return 1
    [ -n "$F_lower$F_schedule$F_pipeline" ] && return 0
    grep -q 'transform\.named_sequence' "$1" && return 0
    grep -qE '\b(func|arith|scf|cf|vector|memref|linalg|tensor|affine|math|ub|index)\.[a-z_]+' "$1"
}

# LLVM IR of a .mlir file on stdout, lowering it first when needed.
mlir_to_llvm_ir() {
    if mlir_needs_lower "$1"; then
        mlir_lower_file "$1" | "${BIN}/mlir-translate" --mlir-to-llvmir
    else
        "${BIN}/mlir-translate" --mlir-to-llvmir "$1"
    fi
}

mlir_lower() {
    parse_args "schedule pipeline emit" "$@"
    need 1 1 "mlir lower <file> [--schedule F] [--pipeline P] [--emit E]"
    local input=${POS[0]} emit=${F_emit:-stdout}
    set_out "$emit" "${input%.*}.llvm.mlir"
    log "Lowering ${input} (emit: ${emit})"
    mlir_lower_file "$input" "${OUT[@]}"
}

mlir_translate() {
    parse_args "to emit" "$@"
    need 1 1 "mlir translate <file> [--to ll|bc] [--emit E]"
    local input=${POS[0]} to=${F_to:-ll} emit=${F_emit:-file}
    case $to in
        ll|bc) ;;
        *) die "unknown --to '${to}' (expected ll or bc)" ;;
    esac
    case $emit in
        file|stdout) set_out "$emit" "${input%.*}.${to}" ;;
        *) die "unknown --emit '${emit}' (expected file or stdout)" ;;
    esac
    log "Translating ${input} to LLVM $([ "$to" = ll ] && echo IR || echo bitcode)"
    if [ "$to" = ll ]; then
        "${BIN}/mlir-translate" --mlir-to-llvmir "$input" "${OUT[@]}"
    else
        "${BIN}/mlir-translate" --mlir-to-llvmir "$input" | "${BIN}/llvm-as" "${OUT[@]}"
    fi
    [ "$emit" = file ] && note "output: ${OUT[1]}"
    return 0
}

mlir_compile() {
    parse_args "o O schedule pipeline lower! no-lower!" "$@"
    need 1 1 "mlir compile <file> [-o OUT] [-O L] [--schedule F] [--pipeline P] [--lower|--no-lower]"
    check_lowering_flags
    local input=${POS[0]} out=${F_o:-${POS[0]%.*}} opt=${F_O:--O0} tmp
    tmp=$(mktemp -d)
    trap "rm -rf '${tmp}'" EXIT
    log "Compiling ${input} to executable ${out} (llc opts: ${opt})"
    mlir_to_llvm_ir "$input" | "${BIN}/llc" "$opt" -filetype=obj -o "${tmp}/out.o"
    link_exe "${tmp}/out.o" -o "$out"
}

mlir_asm() {
    parse_args "cpu O llc-flags emit schedule pipeline lower! no-lower!" "$@"
    need 1 1 "mlir asm <file> [--cpu C] [-O L] [--llc-flags F] [--emit E] [LOWERING]"
    check_lowering_flags
    local input=${POS[0]} cpu=${F_cpu:-native} opt=${F_O:--O3} emit=${F_emit:-stdout}
    set_out "$emit" "${input%.*}.s"
    log "Assembly of ${input} (-mcpu=${cpu} ${opt}, emit: ${emit})"
    # shellcheck disable=SC2086
    mlir_to_llvm_ir "$input" | "${BIN}/llc" "$opt" -mcpu="$cpu" ${F_llc_flags} "${OUT[@]}"
}

group_mlir() {
    local cmd=${1:-help}
    [ $# -gt 0 ] && shift
    case $cmd in
        debug)     mlir_debug "$@" ;;
        pass)      mlir_pass "$@" ;;
        print-ir)  mlir_print_ir "$@" ;;
        lower)     mlir_lower "$@" ;;
        translate) mlir_translate "$@" ;;
        compile)   mlir_compile "$@" ;;
        asm)       mlir_asm "$@" ;;
        help)      usage_mlir; exit 0 ;;
        *)         usage_mlir >&2; die "unknown mlir command '${cmd}'" ;;
    esac
}

# --- llvm ---
llvm_debug() {
    parse_args "O only emit" "$@"
    need 1 1 "llvm debug <file> [-O L] [--only TYPE] [--emit E]"
    local input=${POS[0]} emit=${F_emit:-stdout} debug=-debug
    set_llvm_out "$emit" "${input%.*}.opt"
    [ -n "$F_only" ] && debug="-debug-only=${F_only}"
    log "Running opt on ${input} (emit: ${emit})"
    "${BIN}/opt" "${F_O:--O0}" -stats "$debug" "${OUT[@]}" "$input"
}

llvm_pass() {
    parse_args "only emit" "$@"
    need 2 2 "llvm pass <file> <pass> [--only TYPE] [--emit E]"
    local input=${POS[0]} pass=${POS[1]} emit=${F_emit:-none}
    local name=${pass%%<*}
    set_llvm_out "$emit" "${input%.*}.${name}"
    log "Running pass ${pass} on ${input} (emit: ${emit})"
    "${BIN}/opt" \
        -passes="${pass}" \
        -debug-only="${F_only:-$name}" \
        -stats \
        "${OUT[@]}" "$input"
}

llvm_pipeline() {
    parse_args "O" "$@"
    need 0 0 "llvm pipeline [-O L]"
    local opt=${F_O:--O0}
    log "Printing LLVM pipeline for ${opt}"
    "${BIN}/opt" --print-pipeline-passes "$opt" -S /dev/null -o /dev/null
}

llvm_compile() {
    parse_args "o O" "$@"
    need 1 1 "llvm compile <file> [-o OUT] [-O L]"
    local input=${POS[0]} out=${F_o:-${POS[0]%.*}} opt=${F_O:--O0} tmp
    tmp=$(mktemp -d)
    trap "rm -rf '${tmp}'" EXIT
    log "Compiling ${input} to executable ${out} (llc opts: ${opt})"
    "${BIN}/llc" "$opt" -filetype=obj "$input" -o "${tmp}/out.o"
    link_exe "${tmp}/out.o" -o "$out"
}

llvm_link() {
    parse_args "o O" "$@"
    need 1 1 "llvm link <file> [-o OUT] [-O L]"
    local input=${POS[0]} out=${F_o:-${POS[0]%.*}} opt=${F_O:--O0}
    log "Compiling ${input} to executable ${out} (${opt})"
    link_exe "$opt" "$input" -o "$out"
}

llvm_asm() {
    parse_args "cpu O llc-flags emit" "$@"
    need 1 1 "llvm asm <file> [--cpu C] [-O L] [--llc-flags F] [--emit E]"
    local input=${POS[0]} cpu=${F_cpu:-native} opt=${F_O:--O3} emit=${F_emit:-stdout}
    set_out "$emit" "${input%.*}.s"
    log "Assembly of ${input} (-mcpu=${cpu} ${opt}, emit: ${emit})"
    # shellcheck disable=SC2086
    "${BIN}/llc" "$opt" -mcpu="$cpu" ${F_llc_flags} "${OUT[@]}" "$input"
}

group_llvm() {
    local cmd=${1:-help}
    [ $# -gt 0 ] && shift
    case $cmd in
        debug)    llvm_debug "$@" ;;
        pass)     llvm_pass "$@" ;;
        pipeline) llvm_pipeline "$@" ;;
        compile)  llvm_compile "$@" ;;
        link)     llvm_link "$@" ;;
        asm)      llvm_asm "$@" ;;
        help)     usage_llvm; exit 0 ;;
        *)        usage_llvm >&2; die "unknown llvm command '${cmd}'" ;;
    esac
}

# --- c ---
c_emit_llvm() {
    parse_args "O emit" "$@"
    need 1 1 "c emit-llvm <file.c> [-O L] [--emit E]"
    local input=${POS[0]} opt=${F_O:--O0} emit=${F_emit:-file}
    case $emit in
        file|stdout) set_out "$emit" "${input%.c}.ll" ;;
        *) die "unknown --emit '${emit}' (expected file or stdout)" ;;
    esac
    log "Emitting LLVM IR for ${input} with ${opt} (emit: ${emit})"
    # shellcheck disable=SC2046
    "${BIN}/clang" -S -emit-llvm "$opt" -fno-discard-value-names $(sysroot) "$input" "${OUT[@]}"
}

c_pass() {
    parse_args "O only" "$@"
    need 2 2 "c pass <file.c> <pass> [-O L] [--only TYPE]"
    local input=${POS[0]} pass=${POS[1]}
    log "Running Clang with pass ${pass} on ${input}"
    # shellcheck disable=SC2046
    "${BIN}/clang" \
        "${F_O:--O0}" \
        -mllvm -debug-only="${F_only:-$pass}" \
        -fno-discard-value-names \
        -S -emit-llvm $(sysroot) \
        "$input" -o -
}

group_c() {
    local cmd=${1:-help}
    [ $# -gt 0 ] && shift
    case $cmd in
        emit-llvm) c_emit_llvm "$@" ;;
        pass)      c_pass "$@" ;;
        help)      usage_c; exit 0 ;;
        *)         usage_c >&2; die "unknown c command '${cmd}'" ;;
    esac
}

# --- Main ---
if [ $# -eq 0 ]; then
    usage
    exit 0
fi

GROUP=$1
shift
case $GROUP in
    build) group_build "$@" ;;
    test)  group_test "$@" ;;
    mlir)  group_mlir "$@" ;;
    llvm)  group_llvm "$@" ;;
    c)     group_c "$@" ;;
    help|-h|--help) usage; exit 0 ;;
    *)     usage >&2; die "unknown group '${GROUP}'" ;;
esac

log "Done"
